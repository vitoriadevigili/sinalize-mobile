<?xml version="1.0" encoding="utf-8"?>
<!--
  Só no build de depuração: libera HTTP sem TLS, porque o back-end local roda em http://
  (10.0.2.2 no emulador ou o IP do computador na rede). A versão de release continua só com HTTPS.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 17+: acessar endereços da rede local (o back-end em 10.0.2.2 ou no IP do computador). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
